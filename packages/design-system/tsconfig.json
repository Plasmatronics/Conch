{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"jsx": "react-jsx",
		"rootDir": "./src",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}
